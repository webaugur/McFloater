# Copy to ~/Data/mcfloater/mcfloater.env on THUMPER after HA onboarding.
# The long-lived HA token stays on Thumper (brain). Tower GUI only talks to the brain.
#
# On Tower5810, a smaller client env is enough:
#   MCFLOATER_BRAIN_URL=http://thumper.local:8750

# --- Brain (Thumper) ---
# Bind for McFloater control plane (Tower clients connect here)
MCFLOATER_BRAIN_BIND=0.0.0.0:8750
# Tower client URL (HTTP JSON API)
# MCFLOATER_BRAIN_URL=http://thumper.local:8750

# Home Assistant (localhost on Thumper)
HA_URL=http://127.0.0.1:8123
# Long-lived access token: HA → profile → Security → Create token
HA_TOKEN=

# Optional: default scene / entities for McFloater intents (Phase D)
HA_SCENE_ALL_OFF=scene.all_off
HA_SCENE_LAB_ON=scene.lab_on

# --- Natural TTS on Thumper (Piper) ---
# Install: deploy/thumper/install-piper.sh
# LOCKED default voice: en_US-ryan-medium (young adult male).
# Optional models: joe, lessac, alan, northern_english_male, alba, amy
# (point MCFLOATER_PIPER_MODEL at another .onnx to switch)
MCFLOATER_PIPER_BIN=$HOME/Data/mcfloater/piper/piper
MCFLOATER_PIPER_MODEL=$HOME/Data/mcfloater/piper/en_US-ryan-medium.onnx
MCFLOATER_TTS_ENGINE=piper
# Tower client: mcfloater say "hello"  or  --engine brain

# --- Path B only: headless audio via Pulse tunnel (see deploy/thumper/audio/) ---
# Not needed when GUI + mic/speakers run locally on Tower5810.
MCFLOATER_CAPTURE_DEVICE=tower_mic
MCFLOATER_PLAYBACK_DEVICE=tower_speakers
# TOWER_HOST=10.0.0.113

# Environment for mcfloater-vision.service
# Copy to ~/.config/mcfloater/vision.env and fill in real values

# Path to the LingBot-Map checkpoint (downloaded from Hugging Face)
LINGBOT_MODEL_PATH=/home/user/Data/lingbot-map/lingbot-map.pt

# CUDA device(s) to use (comma-separated). Keep separate from avatar GPU if possible.
CUDA_VISIBLE_DEVICES=0

# Optional: FlashInfer backend (recommended)
# FLASHINFER=1

# Vision service port (brain talks to this)
VISION_PORT=8760

# Optional language / sky mask settings
# MASK_SKY=1
# SKY_MASK_DIR=/tmp/sky_masks